{
  "name": "@portproof/mcp",
  "version": "0.2.4",
  "type": "module",
  "description": "Mobile 4G/5G and residential proxies for AI agents: build proxy URLs, test connections and buy proxy traffic by the GB for price monitoring, ad verification and geo-testing",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "proxy",
    "proxies",
    "mobile-proxy",
    "residential-proxy",
    "4g",
    "5g",
    "ai-agents",
    "claude",
    "cursor",
    "socks5",
    "http-proxy",
    "price-monitoring",
    "ad-verification",
    "web-scraping",
    "geo-testing"
  ],
  "homepage": "https://portproof.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portproofas/portproof-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/portproofas/portproof-mcp/issues"
  },
  "license": "MIT",
  "author": "Portproof",
  "mcpName": "org.portproof/mcp",
  "bin": {
    "portproof-mcp": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "llms.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:stub": "tsx scripts/smoke.ts --stub",
    "mirror:stage": "node scripts/stage-mirror.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ulid": "^3.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@portproof/shared": "*",
    "esbuild": "^0.25.12"
  }
}
